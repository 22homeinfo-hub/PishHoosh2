{
  "name": "diyar-amlak-bot",
  "version": "1.3.0",
  "description": "ربات هوشمند پیش‌هوش - دریافت اطلاعات فایل و تخمین قیمت برای دفتر املاک دیار (تلگرام + مینی‌اپ تلگرام + وب)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "doctor": "node src/doctor.js",
    "miniapp:preview": "node --import ./tools/register-preview.mjs tools/miniapp-preview.mjs",
    "test": "node --test --import ./test/register.mjs test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "google-spreadsheet": "^4.1.4",
    "node-telegram-bot-api": "^0.66.0"
  }
}
