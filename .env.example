# ── تلگرام ─────────────────────────────────────────────
# از BotFather بگیرید
TELEGRAM_BOT_TOKEN=123456789:AA...
# اگر true باشد، ربات در گروه‌ها هم (فقط وقتی منشن شود) پاسخ می‌دهد
ALLOW_GROUP_CHATS=false
# شناسهٔ عددی چت مدیر؛ هشدارهای خرابی (مثل ثبت‌نشدن لید در شیت) به آن ارسال می‌شود
# برای گرفتن شناسهٔ خودتان به @userinfobot پیام بدهید
ADMIN_CHAT_ID=

# ── هوش مصنوعی (Gemini) ────────────────────────────────
# از https://aistudio.google.com/apikey
GEMINI_API_KEY=
# نام مدل؛ پیش‌فرض gemini-3.6-flash است. گزینهٔ ارزان‌تر: gemini-2.5-flash
GEMINI_MODEL=gemini-3.6-flash
# سطح تفکر مدل: minimal | low | medium | high
# برای این کار «low» کافی است و هم سریع‌تر و هم ارزان‌تر است
GEMINI_THINKING_LEVEL=low

# ── گوگل‌شیت ───────────────────────────────────────────
# بخشی از لینک شیت، بین /d/ و /edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=diyar-bot-sheets@your-project.iam.gserviceaccount.com
# کلید خصوصی چندخطی است؛ دقیقاً همان مقدار داخل فایل JSON را (با \n) بگذارید
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# نام تب‌ها (اگر در شیت شما متفاوت است عوضشان کنید)
PROJECTS_SHEET_TITLE=Projects
LEADS_SHEET_TITLE=Leads
# مدت زمان کش کردن لیست پروژه‌ها به میلی‌ثانیه (پیش‌فرض ۲ دقیقه)
SHEET_CACHE_TTL_MS=120000

# ── سرور وب / لندینگ‌پیج ───────────────────────────────
PORT=3000
HOST=0.0.0.0
# دامنه‌های مجاز برای صدا زدن API، با کاما جدا کنید. برای همه: *
# نمونه: CORS_ORIGIN=https://diyar-amlak.ir,https://www.diyar-amlak.ir
CORS_ORIGIN=
# سقف درخواست در دقیقه (برای جلوگیری از مصرف سهمیهٔ Gemini)
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_IP_PER_MINUTE=60
MAX_MESSAGE_LENGTH=2000
# عمر نشست‌ها به دقیقه
SESSION_TTL_MINUTES=120

# ── مینی‌اپ تلگرام ───────────────────────────────────────
# آدرس «عمومی و HTTPS» صفحهٔ مینی‌اپ که روی همین سرویس ارائه می‌شود (/app).
# فقط برای دستور /app و گزارش /api/miniapp-status استفاده می‌شود؛ ورودی مینی‌اپ
# در تلگرام (دکمهٔ منو) دستی در BotFather مدیریت می‌شود و سرویس ست‌اش نمی‌کند.
# ⬅️ روی Railway لازم نیست این را بگذارید: آدرس خودش از RAILWAY_PUBLIC_DOMAIN
#    ساخته می‌شود (https://<دامنه>/app). فقط وقتی لازم است که دامنهٔ اختصاصی
#    دارید یا روی پلتفرم دیگری دیپلوی می‌کنید.
# نمونه: MINI_APP_URL=https://amlak.diyar.ir/app
MINI_APP_URL=
# حداکثر عمر مجاز initData تلگرام به ثانیه (پیش‌فرض ۲۴ ساعت = 86400)
# بعد از آن، کاربر باید مینی‌اپ را دوباره باز کند
MINI_APP_INIT_DATA_MAX_AGE_SECONDS=86400
